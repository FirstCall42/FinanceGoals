root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error   # use file-scoped namespace
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error
dotnet_diagnostic.IDE0005.severity = error   # unnecessary using

# Style
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0055.severity = warning  # formatting

# Constructors: explicit constructors, never primary constructors
csharp_style_prefer_primary_constructors = false:warning
dotnet_diagnostic.IDE0290.severity = none     # do not suggest primary constructors

# Naming: private members (fields, including static, readonly and const) are _camelCase
dotnet_naming_rule.private_members.symbols = private_members
dotnet_naming_rule.private_members.style = underscore_camel
dotnet_naming_rule.private_members.severity = warning
dotnet_diagnostic.IDE1006.severity = warning  # naming rules, enforced in build
dotnet_naming_symbols.private_members.applicable_kinds = field
dotnet_naming_symbols.private_members.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
