{
  "openapi": "3.1.1",
  "info": {
    "title": "FinanceGoals.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/currencies": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The currencies the app supports, ordered by code.",
        "operationId": "ListCurrencies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CurrencyInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/loans/calculate": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The payment schedule of a variable-rate annuity loan, without and with extra payments. Nothing is stored.",
        "operationId": "CalculateLoan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanCalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanCalculationResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The Google client ID the web app signs in with; null when sign-in is not set up.",
        "operationId": "GetSignInConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Records the sign-in of the Google account in the bearer token; returns the user and their profiles, creating one on the first sign-in.",
        "operationId": "SignIn",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The profile, with the caller's role in it.",
        "operationId": "GetProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Renames the profile. Owners only.",
        "operationId": "RenameProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/members": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The profile's members and their roles.",
        "operationId": "ListProfileMembers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileMember"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrencyInfo": {
        "required": [
          "code",
          "numericCode",
          "minorUnits",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "numericCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int16"
          },
          "minorUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint8"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "A currency the app knows, as seeded from ISO 4217."
      },
      "ExtraPaymentInput": {
        "required": [
          "date",
          "amount"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "A one-off extra repayment."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoanCalculationRequest": {
        "required": [
          "currency",
          "minorUnits",
          "principal",
          "firstPayment",
          "termMonths",
          "startRatePercent"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "minorUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "principal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "firstPayment": {
            "type": "string",
            "format": "date"
          },
          "termMonths": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startRatePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "paidOut": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "feePerPayment": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 0
          },
          "rateChanges": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RateChangeInput"
            }
          },
          "extras": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ExtraPaymentInput"
            }
          },
          "monthlyExtras": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/MonthlyExtraInput"
            }
          }
        },
        "description": "A variable-rate annuity loan to calculate, nothing stored. Amounts are in string LoanCalculationRequest.Currency,\r\nwhich has int LoanCalculationRequest.MinorUnits decimals (the web app has both from GET /api/currencies)."
      },
      "LoanCalculationResult": {
        "required": [
          "currency",
          "withoutExtra",
          "withExtra",
          "monthsSaved",
          "interestSaved",
          "withoutExtraSchedule",
          "withExtraSchedule"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "withoutExtra": {
            "$ref": "#/components/schemas/ScheduleSummary"
          },
          "withExtra": {
            "$ref": "#/components/schemas/ScheduleSummary"
          },
          "monthsSaved": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "interestSaved": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "withoutExtraSchedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleRow"
            }
          },
          "withExtraSchedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleRow"
            }
          }
        },
        "description": "The schedule without and with the extra payments, and what the extras save."
      },
      "MonthlyExtraInput": {
        "required": [
          "amount",
          "from",
          "until"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "until": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        },
        "description": "An extra repayment with every payment from a date, optionally until a date."
      },
      "ProfileMember": {
        "required": [
          "userId",
          "email",
          "name",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/ProfileRole"
          }
        },
        "description": "A member of a profile."
      },
      "ProfileRole": {
        "enum": [
          "Member",
          "Owner"
        ],
        "description": "What a user may do in a profile. Owners also manage the profile and its members."
      },
      "ProfileSummary": {
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ProfileRole"
          }
        },
        "description": "A profile as one of its members sees it."
      },
      "RateChangeInput": {
        "required": [
          "from",
          "annualRatePercent"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "annualRatePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "A rate change: the nominal annual rate in percent (5.24 is 5.24 %) from a date."
      },
      "RenameProfile": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A new name for a profile."
      },
      "ScheduleRow": {
        "required": [
          "number",
          "date",
          "annualRatePercent",
          "openingBalance",
          "interest",
          "principal",
          "payment",
          "extra",
          "fee",
          "balance"
        ],
        "type": "object",
        "properties": {
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "annualRatePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "openingBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "interest": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "principal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "payment": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "extra": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "fee": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "One payment; every amount is in the result's currency."
      },
      "ScheduleSummary": {
        "required": [
          "lastPayment",
          "payments",
          "totalInterest",
          "totalExtra"
        ],
        "type": "object",
        "properties": {
          "lastPayment": {
            "type": "string",
            "format": "date"
          },
          "payments": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalInterest": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "totalExtra": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "When a schedule ends and what it costs."
      },
      "SignedIn": {
        "required": [
          "user",
          "profiles"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileSummary"
            }
          }
        },
        "description": "The signed-in user and the profiles they belong to."
      },
      "SignInConfig": {
        "required": [
          "googleClientId"
        ],
        "type": "object",
        "properties": {
          "googleClientId": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "What the web app needs to show the Google sign-in button."
      },
      "User": {
        "required": [
          "id",
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A person who has signed in, as the app knows them."
      }
    }
  },
  "tags": [
    {
      "name": "FinanceGoals.Api"
    }
  ]
}