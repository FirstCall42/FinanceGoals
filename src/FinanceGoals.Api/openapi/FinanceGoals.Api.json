{
  "openapi": "3.1.1",
  "info": {
    "title": "FinanceGoals.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/currencies": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The currencies the app supports, ordered by code.",
        "operationId": "ListCurrencies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CurrencyInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/loans/calculate": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The payment schedule of a variable-rate annuity loan, without and with extra payments. Nothing is stored.",
        "operationId": "CalculateLoan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanCalculationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanCalculationResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The Google client ID the web app signs in with; null when sign-in is not set up.",
        "operationId": "GetSignInConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Records the sign-in of the Google account in the bearer token; returns the user and their profiles, creating one on the first sign-in.",
        "operationId": "SignIn",
        "parameters": [
          {
            "name": "createProfile",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/accept": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Joins the profile of an invite link as a Member. The signed-in account's email must match the invite.",
        "operationId": "AcceptInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedInvite"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The profile, with the caller's role in it.",
        "operationId": "GetProfile",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Changes the profile's name and/or main currency. Owners only.",
        "operationId": "UpdateProfile",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/members": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The profile's members and their roles.",
        "operationId": "ListProfileMembers",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileMember"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/invites": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Invites someone by the email of their Google account. Returns the single-use token for the link, once. Owners only.",
        "operationId": "InviteMember",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMember"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvite"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Invites that are not used or expired yet. Owners only.",
        "operationId": "ListInvites",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PendingInvite"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/invites/{inviteId}": {
      "delete": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Withdraws a pending invite. Owners only.",
        "operationId": "RevokeInvite",
        "parameters": [
          {
            "name": "inviteId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/profiles/{profileId}/accounts": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The household's accounts, by name. Archived ones only with includeArchived=true.",
        "operationId": "ListAccounts",
        "parameters": [
          {
            "name": "includeArchived",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Adds an account to the household.",
        "operationId": "CreateAccount",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/accounts/{accountId}": {
      "patch": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Changes an account: name, type, currency, or archive and restore it.",
        "operationId": "UpdateAccount",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/values": {
      "get": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "The household's account balances, newest first; one account's with accountId.",
        "operationId": "ListAccountValues",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccountValue"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/snapshots": {
      "post": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Records the balances of several accounts on one date. A balance already recorded for that account and date is replaced; accounts left out are not recorded.",
        "operationId": "SaveSnapshot",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSnapshot"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotSaved"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/{profileId}/snapshots/{date}": {
      "delete": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Deletes every balance recorded on a date.",
        "operationId": "DeleteSnapshot",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/profiles/{profileId}/accounts/{accountId}/values/{date}": {
      "delete": {
        "tags": [
          "FinanceGoals.Api"
        ],
        "summary": "Deletes one account's balance on a date.",
        "operationId": "DeleteAccountValue",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "description": "The household profile; the caller must be a member (404 otherwise).",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptedInvite": {
        "required": [
          "profileId"
        ],
        "type": "object",
        "properties": {
          "profileId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "The profile an accepted invite joined."
      },
      "AcceptInvite": {
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The token from an invite link."
      },
      "Account": {
        "required": [
          "id",
          "name",
          "type",
          "currencyCode",
          "archived"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currencyCode": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "description": "An account of a household, in one currency."
      },
      "AccountType": {
        "enum": [
          "Brokerage",
          "Savings",
          "Deposit",
          "Current",
          "Pension",
          "Property"
        ],
        "description": "What kind of account it is. No individual holdings are tracked, only the account's value."
      },
      "AccountValue": {
        "required": [
          "accountId",
          "date",
          "amount"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "An account's balance on a date, in the account's currency."
      },
      "CreateAccount": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "currencyCode": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A new account."
      },
      "CreatedInvite": {
        "required": [
          "id",
          "email",
          "expiresAt",
          "token"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          }
        },
        "description": "A new invite; string CreatedInvite.Token goes in the link and is never stored or shown again."
      },
      "CurrencyInfo": {
        "required": [
          "code",
          "numericCode",
          "minorUnits",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "numericCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int16"
          },
          "minorUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint8"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "A currency the app knows, as seeded from ISO 4217."
      },
      "ExtraPaymentInput": {
        "required": [
          "date",
          "amount"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "A one-off extra repayment."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InviteMember": {
        "type": "object",
        "properties": {
